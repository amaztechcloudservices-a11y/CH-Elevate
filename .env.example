DATABASE_URL=postgresql://premium:premium@localhost:55434/premium_web
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Optional social providers; enable only providers approved for the client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Workspace SMTP. Store the app password only in local/production environment files.
# Example format: smtps://info%40ch-elevateconsultancy.com:APP_PASSWORD@smtp.gmail.com:465
SMTP_URL=
CONTACT_FROM=CH Elevate Consultancy Limited <info@ch-elevateconsultancy.com>
CONTACT_TO=info@ch-elevateconsultancy.com

# Private persistent Hostinger volume; never point this inside /public.
COURSE_STORAGE_DIR=/var/lib/ch-elevate/course-portal
# Public images uploaded by administrators. Keep this on persistent storage.
PUBLIC_IMAGE_STORAGE_DIR=/var/lib/ch-elevate/public-images
COURSE_PORTAL_URL=http://localhost:3000
