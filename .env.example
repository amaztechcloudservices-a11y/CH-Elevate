DATABASE_URL=postgresql://premium:premium@localhost:55434/premium_web
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Optional social providers; enable only providers approved for the client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Hostinger email or another SMTP service approved by the client.
SMTP_URL=smtps://username:password@smtp.hostinger.com:465
CONTACT_FROM=Website <website@example.com>
CONTACT_TO=info@ch-elevateconsultancy.com

# Private persistent Hostinger volume; never point this inside /public.
COURSE_STORAGE_DIR=/var/lib/ch-elevate/course-portal
COURSE_PORTAL_URL=http://localhost:3000
