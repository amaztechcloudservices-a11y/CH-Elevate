[Unit]
Description=CH Elevate operational mail worker
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=ch-elevate
Group=ch-elevate
WorkingDirectory=/opt/ch-elevate/source
EnvironmentFile=/etc/ch-elevate/ch-elevate.env
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/pnpm exec tsx scripts/process-operational-mail.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ch-elevate

[Install]
WantedBy=multi-user.target
